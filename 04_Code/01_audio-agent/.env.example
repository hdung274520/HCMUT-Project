# =============================================================
# Voice Agent configuration
# Copy to .env.local and fill in. Two ready-made profiles:
#   MODE=api    -> STT=gemini,        LLM=gemini, TTS=gtts   (online, needs GEMINI_API_KEY only)
#   MODE=local  -> STT=faster_whisper,LLM=ollama, TTS=piper  (100% offline)
# You can also override each component independently below.
# =============================================================

# api | local  (sets the defaults for the three components below)
MODE=api

# Spoken language (English-only build)
LANGUAGE=en

# --- Per-component override (leave blank to use the MODE defaults) ---
# STT_PROVIDER:  faster_whisper | gemini
STT_PROVIDER=
# TTS_PROVIDER:  piper (offline, fast, clear — benchmark winner, see README) | silero (offline, slower, can sound robotic) | gtts (online)
TTS_PROVIDER=
# LLM_PROVIDER:  gemini | ollama
LLM_PROVIDER=

# --- Local TTS (Silero) ---
# Voice for the "silero" provider: en_0 .. en_117, or "random". en_56 is a clear
# default; run `python -c "from src.tts import SileroTTS; print(SileroTTS().model.speakers)"`
# to list all of them.
SILERO_SPEAKER=en_56

# --- Google Gemini (LLM + optional API STT) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Local STT (faster-whisper) ---
# Leave blank to auto-pick by hardware (tiny on Raspberry Pi, distil-medium.en
# on a dev PC — benchmark winner, see README).
WHISPER_MODEL=

# --- Local LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
# Leave blank to auto-pick by detected hardware (qwen2.5:0.5b on both Pi and dev
# PC — benchmark winner, see README: ties the best rating while being by far
# the fastest).
OLLAMA_MODEL=

# --- Microphone / turn detection ---
SILENCE_THRESHOLD=0.012     # RMS below this counts as silence (raise if noisy room)
SILENCE_DURATION=0.9        # seconds of silence that ends your turn
MAX_RECORD_SECONDS=20       # hard cap per utterance
