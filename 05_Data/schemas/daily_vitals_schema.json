{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyVitalsAndActivities",
  "description": "Daily summary computed nightly by AWS from Raspberry Pi sessions (Muse 2, Magene H303) and spot measurements (Yuwell YX110). There is no 24/7 wearable, so summary fields are only present when measured that day.",
  "type": "object",
  "required": ["metadata", "daily_summary"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["user_id", "date", "computed_at"],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "computed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the AWS daily aggregation Lambda produced this summary"
        }
      }
    },
    "daily_summary": {
      "type": "object",
      "properties": {
        "resting_heart_rate_bpm": {
          "type": "integer",
          "description": "Morning H303 reading (fallback: lowest overnight H303 heart rate)"
        },
        "average_blood_oxygen_pct": {
          "type": "number",
          "description": "Mean of the Yuwell YX110 spot measurements of the day",
          "minimum": 0,
          "maximum": 100
        },
        "average_blood_pressure": {
          "type": "object",
          "required": ["systolic", "diastolic"],
          "properties": {
            "systolic": {
              "type": "integer"
            },
            "diastolic": {
              "type": "integer"
            }
          }
        },
        "sleep_summary": {
          "type": "object",
          "properties": {
            "total_sleep_seconds": {
              "type": "integer"
            },
            "sleep_score": {
              "type": "integer"
            }
          }
        }
      }
    },
    "activities": {
      "type": "object",
      "description": "Derived from H303 workout sessions (the system has no step counter)",
      "required": ["active_minutes", "calories_burned_kcal"],
      "properties": {
        "active_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "calories_burned_kcal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "heart_rate_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "bpm", "source_device"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "bpm": {
            "type": "integer"
          },
          "source_device": {
            "type": "string",
            "enum": ["muse2_ppg", "magene_h303", "yuwell_yx110", "simulator"]
          }
        }
      }
    },
    "blood_oxygen_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "spo2_pct", "source_device"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "spo2_pct": {
            "type": "number"
          },
          "pulse_bpm": {
            "type": "integer"
          },
          "source_device": {
            "type": "string",
            "enum": ["muse2_ppg", "magene_h303", "yuwell_yx110", "simulator"]
          }
        }
      }
    },
    "workout_sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workout_id", "type", "timestamp_start", "timestamp_end", "duration_seconds", "calories_burned_kcal"],
        "properties": {
          "workout_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string",
            "description": "Matching active session (session_type = workout)"
          },
          "type": {
            "type": "string"
          },
          "timestamp_start": {
            "type": "string",
            "format": "date-time"
          },
          "timestamp_end": {
            "type": "string",
            "format": "date-time"
          },
          "duration_seconds": {
            "type": "integer"
          },
          "calories_burned_kcal": {
            "type": "integer"
          },
          "average_heart_rate": {
            "type": "integer"
          },
          "max_heart_rate": {
            "type": "integer"
          },
          "source_device": {
            "type": "string",
            "enum": ["muse2_ppg", "magene_h303", "yuwell_yx110", "simulator"]
          }
        }
      }
    }
  }
}
